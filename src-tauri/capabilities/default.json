{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*", "app": true },
        { "url": "http://*", "app": true },
        { "url": "mailto:*", "app": true },
        { "url": "tel:*", "app": true }
      ]
    },
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/Downloads/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/**" }
      ]
    },
    "updater:default",
    "process:default",
    "deep-link:default",
    "notification:default",
    "allow-fetch-cover-image",
    "allow-fetch-nautiljon-planning",
    "allow-fetch-nautiljon-search",
    "allow-browse-nautiljon-fiche",
    "allow-fetch-adkami-agenda",
    "allow-fetch-adkami-anime-page",
    "allow-fetch-adkami-search",
    "allow-oauth-token-exchange",
    "allow-open-url-with-app",
    "allow-open-catalog-webview",
    "allow-local-archive"
  ]
}
